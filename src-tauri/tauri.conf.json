{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoidTrace",
  "version": "0.3.1",
  "identifier": "dev.vxnsin.voidtrace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VoidTrace",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "url": "index.html",
        "visible": false
      },
      {
        "label": "overlay",
        "title": "VoidTrace Overlay",
        "url": "index.html#/overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "visible": false,
        "resizable": false,
        "width": 1200,
        "height": 220,
        "x": 360,
        "y": 60
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4RjZEMDUwOUIxN0U1M0YKUldRLzVSZWJVTkQyU0FHQzhwWW1HcnhzQ09YUlRNRitVbzlkL0hUSHFqYkxSRWJHREM3Z0tQRVMK",
      "endpoints": [
        "https://github.com/vxnsin/voidtrace/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
